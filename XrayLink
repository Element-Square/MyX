#=======================================================
# 策略组配置
#=======================================================
proxy-groups:
  # 默认主代理控制
  - name: 🚀 节点选择
    type: select
    proxies:
      - 自动选择（延迟最低）
      - 🇭🇰 hkg22_reality
      - 🇯🇵 jppro4_reality
      - 🇺🇸 US_reality
      - DIRECT

  # 自动测速延迟策略组
  - name: 自动选择（延迟最低）
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    proxies:
      - 🇭🇰 hkg22_reality
      - 🇯🇵 jppro4_reality
      - 🇺🇸 US_reality

#=======================================================
# 路由分流规则（GEO 基础规则）
#=======================================================
rules:
  # 局域网和本地流量直连
  - GEOIP,lan,DIRECT,no-resolve
  
  # 中国大陆 IP 和 域名直连（绕过代理）
  - GEOSITE,cn,DIRECT
  - GEOIP,CN,DIRECT

  # 兜底规则：其余未匹配到的海外流量全部走节点选择
  - MATCH,🚀 节点选择
